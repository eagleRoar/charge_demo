30:               void gpio_init(void)
31:               {
32:               	//RA0输出高电平
33:               	TRISA = 0B11111110;//RA0 方向:输出
  004E    30FE    LDIA	0xFE
  004F    1683    SETB	0x3,5
  0050    0085    LD	0x5,A
34:               	PORTA = 0B0000001;//RA0 电平:高
  0051    3001    LDIA	0x1
  0052    0086    LD	0x6,A
  0053    0008    RET
35:               }
36:               
37:               void test_io_high()
38:               {
39:               	PORTA |= 0B00000001;//RA0 电平:高
40:               }
41:               
42:               void test_io_low()
43:               {
44:               	PORTA &= 0B11111110;//RA0 电平:低
45:               }
46:               
47:               void control_test_io(unsigned int flag)
48:               {
49:               	if(flag)
50:               	{
51:               		test_io_high();
52:               	}
53:               	else
54:               	{
55:               		test_io_low();
56:               	}
57:               }
