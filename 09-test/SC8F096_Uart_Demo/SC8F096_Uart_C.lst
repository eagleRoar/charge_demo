97:               /***********************************************
98:               函数名称：Init_System
99:               函数功能：系统初始化
100:              入口参数：无
101:              出口参数：无
102:              备注：
103:              ************************************************/
104:              void Init_System()
105:              {
106:              	asm("nop");
107:              	asm("clrwdt");
108:              	INTCON = 0;					//系统初始化
109:              	OSCCON = 0X70;				//配置振荡为8M,
110:              	OPTION_REG = 0;
111:              	
112:                  WPUA  = 0B00000000;			//初始化上拉
113:                  WPUB  = 0B00001000;			
114:                
115:               
116:              	TRISA = 0B00000000;			//初始化IO状态
117:              	TRISB = 0B00011000;
118:              
119:              	PORTA = 0B00000000;
120:              	PORTB = 0B00000000;			//初始化输出
121:              	
122:              	/**************   TXSTA   **************************************
123:              		Bit7 CSRC: 时钟源选择位；  异步模式: 任意值；  同步模式:  
124:              			1=主控模式（由内部BRG产生时钟信号）；  
125:              			0=从动模式（由外部时钟源产生时钟）。 
126:              		Bit6 TX9EN: 9位发送使能位；  
127:              			1= 选择9位发送；  
128:              			0= 选择8位发送。 
129:              		Bit5 TXEN: 发送使能位(1)；  
130:              			1= 使能发送；  
131:              			0= 禁止发送。 
132:              		Bit4 SYNC: USART模式选择位；  
133:              			1= 同步模式；  
134:              			0= 异步模式。 
135:              		Bit3 SCKP: 同步时钟极性选择位。  
136:              			异步模式:  
137:              				1=将数据字符的电平取反后发送到TX/CK引脚；  
138:              				0=直接将数据字符发送到TX/CK引脚。  
139:              			同步模式:  
140:              				0=在时钟上升沿传输数据；  
141:              				1=在时钟下降沿传输数据。 
142:              		Bit2 STOPBIT: 停止位选择（仅对异步发送有效），当通过判断TRMT=1来送数据时，此位需写0。  
143:              			1= 1位停止位；  
144:              			0= 2位停止位。 
145:              		Bit1 TRMT: 发送移位寄存器状态位；  
146:              			1= TSR为空；  
147:              			0= TSR为满。 
148:              		Bit0 TX9D: 发送数据的第9位。 可以是地址/数据位或奇偶校验位
149:              	***********************************************************************/
150:              	TXSTA0 =  0B10100000;		//主控模式，8位数据，异步模式，
151:              	
152:              	/*****************  RCSTA   ***********************************************
153:              		Bit7 SPEN: 串行端口使能位；  
154:              			1= 使能串行端口（将RX/DT和TX/CK引脚配置为串行端口引脚）； 
155:              			0= 禁止串行端口（保持在复位状态）。 
156:              		Bit6 RX9EN: 9位接收使能位；  
157:              			1= 选择9位接收；  
158:              			0= 选择8位接收。 
159:              		Bit5 SREN: 单字节接收使能位。  
160:              			异步模式: 任意值。  
161:              			同步主控模式:  
162:              				1=使能单字节接收；  
163:              				0=禁止单字节接收。 接收完成后清零该位。  
164:              			同步从动模式: 任意值。 
165:              		Bit4 CREN: 连续接收使能位。  
166:              			异步模式:  
167:              				1=使能接收；  
168:              				0=禁止接收。  
169:              			同步模式:  
170:              				1=使能连续接收直到清零CREN使能位（CREN覆盖SREN）；  
171:              				0=禁止连续接收。 
172:              		Bit3 RCIDL: 接收空闲标志位。  
173:              			异步模式: 
174:              				1=接收器空闲；  
175:              				0=已接收到起始位，接收器正在接收数据。  
176:              			同步模式: 任意值。
177:              		Bit2 FERR: 帧错误位。  
178:              			1= 帧错误（可通过读RCREG寄存器更新并接收下一个有效字节）；  
179:              			0= 没有帧错误。 
180:              		Bit1 OERR: 溢出错误位。  
181:              			1= 溢出错误（可通过清零CREN位清零）；  
182:              			0= 没有溢出错误。 
183:              		Bit0 RX9D: 接收到数据的第9位。 此位可以是地址/数据位或奇偶校验位，必须由用户固件计算得到
184:              	*********************************************************************************/
185:              	
186:              	RCSTA0 =  0B10010000;		//使能串口，使能接收
187:              	SPBRG0 =  51;        		 //波特率9600，目标波特率=FOSC/16([SPBRG]+1)
188:              	
189:              	PEIE =1;
190:              	RC0IE =1;
191:              	GIE =1;
192:              
193:              }
194:              
195:              /***********************************************
196:              函数名称：UART_Isr
197:              函数功能：UART中断服务
198:              入口参数：无
199:              出口参数：无
200:              备注：
201:              ************************************************/
202:              void interrupt UART_Isr()
203:              {
204:              	static unsigned char RxNum=0,TEMP;
205:              	
206:              	if(RC0IF==1)
  0023    1283    CLRB	0x3,5
  0024    1303    CLRB	0x3,6
  0025    1F8D    SNZB	0xD,7
  0026    283B    JP	0x3B
207:              	{
208:              		RC0IF = 0;
  0027    138D    CLRB	0xD,7
209:              	    
210:              		if(RXOK_f==0)	
  0028    1873    SZB	0x73,0
  0029    2839    JP	0x39
211:              		{
212:              			RxTable[RxNum] = RCREG0;
  002A    0874    LD	A,0x74
  002B    3E20    ADDIA	0x20
  002C    0084    LD	0x4,A
  002D    1703    SETB	0x3,6
  002E    081C    LD	A,0x1C
  002F    1383    CLRB	0x3,7
  0030    0080    LD	0x0,A
  0031    300A    LDIA	0xA
213:              			RxNum++;
  0032    0AF4    INCR	0x74
214:              			if(RxNum > 9)
  0033    0274    SUBA	0x74
  0034    1C03    SNZB	0x3,0
  0035    283B    JP	0x3B
215:              			{
216:              				RxNum =0;
  0036    01F4    CLR	0x74
217:              				RXOK_f =1;
  0037    1473    SETB	0x73,0
  0038    283B    JP	0x3B
218:              			}
219:              		}
220:              		else
221:              		TEMP =  RCREG0;
  0039    1703    SETB	0x3,6
  003A    081C    LD	A,0x1C
  003B    0872    LD	A,0x72
  003C    008A    LD	0xA,A
  003D    0871    LD	A,0x71
  003E    0084    LD	0x4,A
  003F    0E70    SWAPA	0x70
  0040    0083    LD	0x3,A
  0041    0EFE    SWAPR	0x7E
  0042    0E7E    SWAPA	0x7E
  0043    0009    RETI
222:              		
223:              	}
224:              }
