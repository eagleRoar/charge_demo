206:              /***********************************************************
207:              中断服务函数
208:              函数名称：Isr_Timer()
209:              函数功能：中断处理函数
210:              入口参数：
211:              出口参数：
212:              备    注：125US定时2中断
213:              			所有中断都是在这个函数里面处理
214:              ***********************************************************/
215:              void interrupt Isr_Timer() 
216:              {
217:              	if (TMR2IF) 
  02CC    1283    CLRB	0x3,5
  02CD    1303    CLRB	0x3,6
  02CE    188D    SZB	0xD,1
218:              	{			//若只使能了一个中断源,可以略去判断
219:              		TMR2IF = 0;
  02CF    108D    CLRB	0xD,1
  02D0    0871    LD	A,0x71
  02D1    008A    LD	0xA,A
  02D2    0E70    SWAPA	0x70
  02D3    0083    LD	0x3,A
  02D4    0EFE    SWAPR	0x7E
  02D5    0E7E    SWAPA	0x7E
  02D6    0009    RETI
220:              
221:              	}
222:              
223:              }
224:              
225:              /***********************************************************
226:              中断服务函数
227:              函数名称：AD_Init()
228:              函数功能：AD初始化处理函数
229:              入口参数：
230:              出口参数：
231:              备    注：第一次打开AD允许位ADON，需延时20uS以上才能进入AD采样
232:              			如后继程序不关闭ADON，则不需要延时
233:              ***********************************************************/
234:              void AD_Init() 
235:              {
236:              	/*********** ADCON0 ****************************
237:              		Bit7~Bit6  ADCS<1:0>:  AD转换时钟选择位。
238:              			00=  F HSI /16
239:              			01=  F HSI /32
240:              			10=  F HSI /64
241:              			11=  F HSI /128
242:              		Bit5~Bit2  CHS<3:0>:  模拟通道选择位。与ADCON1寄存器CHS4组合CHS<3:0>
243:              			CHS<4:0>: 
244:              			00000=  AN0
245:              			00001=  AN1
246:              			00010=  AN2
247:              			00011=  AN3
248:              			00100=  AN4
249:              			00101=  AN5
250:              			… 
251:              			11100=  AN28
252:              			11101=  AN29
253:              			11110=  OPA输出
254:              			11111=  1.2V（固定参考电压）
255:              			其他=  保留
256:              		Bit1  GO/DONE: AD转换状态位。
257:              			1=  AD转换正在进行。将该位置1启动AD转换。当AD转换完成以后，该位由硬件自动清零。
258:              				当GO/DONE位从1变0或ADIF从0变1时，需至少等待两个TAD时间，才能再次启动AD转换。
259:              			0=  AD转换完成/或不在进行中。
260:              		Bit0  ADON:  ADC使能位。
261:              			1=  使能ADC；
262:              			0=  禁止ADC，不消耗工作电流。
263:              	*********************************************/
264:              	ADCON0 = 0X41;		//ADON开启，AD采样时间选为FSYS/32
  02D7    3041    LDIA	0x41
  02D8    1683    SETB	0x3,5
  02D9    0095    LD	0x15,A
265:              	
266:              	/*********** ADCON1 ****************************
267:              		Bit7  ADFM:  AD转换结果格式选择位；
268:              			1=  右对齐；
269:              			0=  左对齐。
270:              		Bit6  CHS4:  通道选择位
271:              		Bit5~Bit3  未用 
272:              		Bit2  LDO_EN:  内部参考电压使能位。
273:              			1=  使能ADC内部LDO参考电压；
274:              				当选择内部LDO作参考电压时，ADC最大有效精度为8位。
275:              			0=  VDD作为ADC参考电压。
276:              		Bit1~Bit0  LDO_SEL<1:0>:  参考电压选择位
277:              			0X=  2.0V
278:              			10=  2.4V
279:              			11=  3.0V
280:              	*********************************************/
281:              	ADCON1 = 0;
  02DA    0196    CLR	0x16
  02DB    0008    RET
282:              }
