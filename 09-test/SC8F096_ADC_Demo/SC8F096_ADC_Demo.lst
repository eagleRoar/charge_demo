---- E:\1.workspace\7.other\17.charge_demo\charge_demo\09-test\SC8F096_ADC_Demo\SC8F096_ADC.c ----------------------------------------------------------------------
1:                /**********************************************************
2:                12槽 ADC 采集测试 - 双参数线性标定
3:                SC8F096, 16MHz, UART TX=RC4(J1-CLK), 9600bps
4:                接线: J1-CLK(RC4) → USB-TTL模块RX, J1-GND → 模块GND
5:                注意: 烧录完必须拔掉烧录器, 再接串口模块
6:                
7:                标定点: ADC=3345→1.52V, ADC=3457→1.68V (万用表对照)
8:                公式: V_BAT = (1159*V_B1AD - 647*VCC) / 1000
9:                       α=1.159, β=0.647 (双参数线性拟合, 比叠加定理更吻合实测)
10:               **********************************************************/
11:               #pragma warning disable 752
12:               #pragma warning disable 373
13:               #include <sc.h>
14:               
15:               #ifndef _XTAL_FREQ
16:               #define _XTAL_FREQ 16000000
17:               #endif
18:               
19:               #define     POWER_RATIO      (4096UL*1.2*1000)
20:               #define     SW_TX            RC4
21:               #define     BIT_TIME         104     /* 9600bps */
22:               
23:               /* 双参数线性标定: BAT = (α*V_B1AD - β*VCC), α=1.159, β=0.647 */
24:               #define     ALPHA_NUM        1159UL   /* α * 1000 */
25:               #define     BETA_NUM          647UL   /* β * 1000 */
26:               #define     CAL_DEN           1000UL
27:               
28:               volatile unsigned int adresult;
29:               volatile unsigned char test_adc;
30:               
31:               /* B1..B12对应的ADC通道号 (B1-B5已验证, B6-B12通过卡槽实测校正) */
32:               const unsigned char bx_ch[12] = {
33:                   17,  /* B1=AN17 (验证OK) */
34:                   16,  /* B2=AN16 (验证OK) */
35:                   12,  /* B3=AN12 (验证OK) */
36:                   13,  /* B4=AN13 (验证OK) */
37:                   5,   /* B5=AN5  (验证OK) */
38:                   4,   /* B6=AN4  (实测: 物理B6→原显示B8) */
39:                   28,  /* B7=AN28 (实测: 物理B7→原显示B9) */
40:                   29,  /* B8=AN29 (实测: 物理B8→原显示B10) */
41:                   27,  /* B9=AN27 (实测: 物理B9→原显示B11) */
42:                   26,  /* B10=AN26(实测: 物理B10→原显示B12) */
43:                   7,   /* B11=AN7 (实测: 物理B11→原显示B6) */
44:                   6    /* B12=AN6 (实测: 物理B12→原显示B7) */
45:               };
