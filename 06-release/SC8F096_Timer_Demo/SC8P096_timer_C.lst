  03A9    1686    SETB	0x6,5
103:              		PIN_LED_IO2 = 1;                /* 绿灯亮 */
  03AA    1606    SETB	0x6,4
104:              		if(g_powerOnTimer >= TICK_PER_SEC)
  03AB    3000    LDIA	0x0
  03AC    1683    SETB	0x3,5
  03AD    1303    CLRB	0x3,6
  03AE    022F    SUBA	0x2F
  03AF    306F    LDIA	0x6F
  03B0    1903    SZB	0x3,2
  03B1    022E    SUBA	0x2E
  03B2    1C03    SNZB	0x3,0
  03B3    0008    RET
105:              		{
106:              			g_powerOnTimer = 0;
  03B4    01AE    CLR	0x2E
  03B5    01AF    CLR	0x2F
107:              			g_powerOnPhase = 1;         /* 进入Phase 1 */
