  03C9    1703    SETB	0x3,6
  03CA    1286    CLRB	0x6,5
118:              			PIN_LED_IO2 = 0;
  03CB    1206    CLRB	0x6,4
  03CC    0008    RET
119:              		}
120:              	}
121:              	/* Phase 2: 自检完成, 进入正常扫描 */
122:              }
