15:               
16:               /*========================================================================
17:                 函数: AD_Init
18:                 功能: ADC模块初始化
19:                 配置: 通道AN0, ADC使能, 时钟Fosc/8, 右对齐, 参考电压VDD
20:               ========================================================================*/
21:               void AD_Init(void)
22:               {
23:               	CC0CON = 0;             /* 关闭比较器0 */
24:               	CC1CON = 0;             /* 关闭比较器1 */
25:               	ADCON0 = 0X41;          /* AN0通道, ADC使能, 时钟Fosc/8 */
