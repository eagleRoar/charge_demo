  0BF9    01F2    CLR	0x72
  0BFA    0870    LD	A,0x70
  0BFB    1871    SZB	0x71,0
  0BFC    07F2    ADDR	0x72
  0BFD    1003    CLRB	0x3,0
  0BFE    0DF0    RLCR	0x70
