  004D    3006    LDIA	0x6
  004E    1283    CLRB	0x3,5
  004F    1303    CLRB	0x3,6
  0050    0254    SUBA	0x54
  0051    300C    LDIA	0xC
  0052    00F0    LD	0x70,A
