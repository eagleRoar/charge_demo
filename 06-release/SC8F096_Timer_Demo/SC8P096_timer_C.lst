1:                // 8 x 8 bit multiplication with 8 bit result
2:                
3:                unsigned char
4:                __bmul(unsigned char multiplier, unsigned char multiplicand)
  0228    00A2    LD	0x22,A
  0229    01A1    CLR	0x21
  022A    0820    LD	A,0x20
  022B    1822    SZB	0x22,0
  022C    07A1    ADDR	0x21
