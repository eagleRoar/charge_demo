313:              				break;
  007E    290D    JP	0x10D
314:              
315:              			/* --- Phase 1: 充电状态机处理 + LED更新 ---
316:              			   1. 调用充电状态机处理当前槽位
317:              			   2. 更新当前槽位LED状态 */
