73:               /*========================================================================
74:                 函数: Detect_BatteryType
75:                 功能: 根据ADC电压值判断电池类型
76:                 参数: voltage - ADC采样值(0~4095)
77:                 返回: 电池类型(BAT_TYPE_xxx)
78:                 判断逻辑:
79:                   电压<=ADC_V_SHORT(5)  -> 短路, 不充电
80:                   电压<=ADC_V_ACTIVATE(12) -> 锂电池(过放), 需激活
81:                   电压在NIMH范围(136~161) -> 镍氢电池, 不充电
82:                   电压在预充范围(62~满电) -> 锂电池, 正常充电
83:                   电压>满电(188)且<过压(198) -> 锂电池(已充满)
84:                   其他 -> 未知类型
85:                 说明: 通过开路电压区分电池类型, 避免充错电池
86:               ========================================================================*/
87:               unsigned char Detect_BatteryType(unsigned int voltage)
88:               {
89:               	/* 电压极低: 短路 */
90:               	if(voltage <= ADC_V_SHORT)
  0FA9    3000    LDIA	0x0
  0FAA    0271    SUBA	0x71
  0FAB    3006    LDIA	0x6
  0FAC    1903    SZB	0x3,2
  0FAD    0270    SUBA	0x70
  0FAE    1C03    SNZB	0x3,0
91:               		return BAT_TYPE_SHORT;
  0FAF    3404    RET	0x4
92:               
93:               	/* 电压很低但非短路: 可能是过放锂电池, 需要激活 */
94:               	if(voltage <= ADC_V_ACTIVATE)
  0FB0    3000    LDIA	0x0
  0FB1    0271    SUBA	0x71
  0FB2    300D    LDIA	0xD
  0FB3    1903    SZB	0x3,2
  0FB4    0270    SUBA	0x70
  0FB5    1C03    SNZB	0x3,0
95:               		return BAT_TYPE_LI_ION;
  0FB6    3401    RET	0x1
96:               
97:               	/* 电压在镍氢电池范围: 1.1V~1.3V, 不充电 */
98:               	if(voltage >= ADC_V_NIMH_LOW && voltage <= ADC_V_NIMH_HIGH)
  0FB7    3000    LDIA	0x0
  0FB8    0271    SUBA	0x71
  0FB9    3088    LDIA	0x88
