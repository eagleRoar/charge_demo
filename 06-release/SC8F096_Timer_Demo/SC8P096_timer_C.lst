---- E:\1.workspace\7.other\17.charge_demo\charge_demo\06-release\SC8F096_Timer_Demo\main.c ----------------------------------------------------------------------
1:                /*-------------------------------------------
2:                  L1211 12槽充电器 - 主程序入口
3:                  包含: 系统初始化、主循环、Timer0中断服务、引脚模拟/数字切换
4:                  扫描机制: 每250us(Timer0)扫描一个槽位, 三阶段扫描(ADC->充电处理->LED更新)
5:                  主循环: 空闲等待UART数据回环测试
6:                -------------------------------------------*/
7:                #include "config.h"
8:                #pragma warning disable 752
9:                #pragma warning disable 373
10:               
11:               /*========================================================================
12:                 全局变量定义
13:               ========================================================================*/
14:               volatile unsigned int power_ad;          /* 电源电压(mV), 每1s更新一次 */
15:               
16:               /* 系统计时变量 */
17:               unsigned int  g_timerTick = 0;           /* Timer0中断计数器(125us/tick) */
18:               unsigned int  g_systemTick = 0;          /* 扫描轮次计数器(每轮+1, 222轮=1秒) */
19:               unsigned char g_scanIndex = 0;           /* 当前扫描槽位索引(0~11循环) */
20:               unsigned char g_scanPhase = 0;           /* 当前扫描阶段: 0=ADC采样, 1=充电处理, 2=扫描完成/收尾 */
21:               unsigned int  g_powerOnTimer = 0;        /* 上电自检计时器 */
22:               unsigned char g_powerOnPhase = 0;        /* 上电自检阶段: 0=全亮, 1=保持, 2=正常 */
23:               #if UART_PRINT_EN
24:               volatile bit   g_printFlag = 0;          /* 打印标志: ISR置1, 主循环清0并调用Print_Status */
25:               #endif
26:               
27:               /* PWM/CC-CV 控制变量 */
28:               volatile unsigned char g_pwmDuty = 0;       /* 当前PWM占空比(0~PWM_MAX) */
29:               volatile unsigned char g_pwmCounter = 0;    /* PWM计数器, ISR中0~31循环 */
30:               signed int g_cvIntegral = 0;                /* CV PI积分累加器 */
31:               
32:               /*========================================================================
33:                 ROM只读配置表
34:               ========================================================================*/
35:               /* 12槽BxAD ADC通道映射表
36:                  每个槽位对应一个独立的ADC采样通道, BxAD引脚为纯模拟输入 */
37:               const unsigned char s_adcChannels[BATTERY_SLOTS] = {
38:               	ADC_CH_B1AD,  /* B1 电压采样: AN17 */
39:               	ADC_CH_B2AD,  /* B2 电压采样: AN16 */
40:               	ADC_CH_B3AD,  /* B3 电压采样: AN12 */
41:               	ADC_CH_B4AD,  /* B4 电压采样: AN13 */
42:               	ADC_CH_B5AD,  /* B5 电压采样: AN5  */
43:               	ADC_CH_B6AD,  /* B6 电压采样: AN4  */
44:               	ADC_CH_B7AD,  /* B7 电压采样: AN28 */
45:               	ADC_CH_B8AD,  /* B8 电压采样: AN29 */
46:               	ADC_CH_B9AD,  /* B9 电压采样: AN27 */
47:               	ADC_CH_B10AD, /* B10 电压采样: AN26 */
48:               	ADC_CH_B11AD, /* B11 电压采样: AN7  */
49:               	ADC_CH_B12AD  /* B12 电压采样: AN6  */
50:               };
51:               
52:               /*========================================================================
53:                 函数: System_Init
54:                 功能: 系统初始化, 配置所有外设
55:                 流程:
56:                   1. 配置系统时钟(16MHz内部RC振荡器)
57:                   2. 初始化所有GPIO端口(输出高电平, MOSFET默认关闭)
58:                   3. 关闭所有模拟功能(需要时动态切换)
59:                   4. 配置ADC模块(参考电压/时钟)
60:                   5. 配置UART(9600bps, 8N1)
61:                   6. 配置Timer0(250us周期, 16MHz/4/250=16, 256-16=240→预装TMR0=6)
62:                   7. 使能中断(GIE/PEIE/T0IE/RC1IE)
63:                   8. 初始化控制引脚和槽位数据
64:               ========================================================================*/
