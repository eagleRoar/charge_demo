  03B7    01D2    CLR	0x52
  03B8    0AD2    INCR	0x52
  03B9    0008    RET
108:              		}
109:              	}
110:              	else if(g_powerOnPhase == 1)
  03BA    0B52    SZDECA	0x52
  03BB    0008    RET
111:              	{
112:              		/* Phase 1: 保持全亮1秒 */
113:              		if(g_powerOnTimer >= TICK_PER_SEC)
  03BC    3000    LDIA	0x0
  03BD    1683    SETB	0x3,5
  03BE    022F    SUBA	0x2F
  03BF    306F    LDIA	0x6F
  03C0    1903    SZB	0x3,2
  03C1    022E    SUBA	0x2E
  03C2    1C03    SNZB	0x3,0
  03C3    0008    RET
  03C4    3002    LDIA	0x2
114:              		{
115:              			g_powerOnTimer = 0;
  03C5    01AE    CLR	0x2E
  03C6    01AF    CLR	0x2F
116:              			g_powerOnPhase = 2;         /* 进入Phase 2 */
  03C7    1283    CLRB	0x3,5
  03C8    00D2    LD	0x52,A
