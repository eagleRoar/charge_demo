---- E:\1.workspace\7.other\17.charge_demo\charge_demo\06-release\SC8F096_Timer_Demo\main.c ----------------------------------------------------------------------
1:                /*-------------------------------------------
2:                  L1211 12槽充电器 - 主程序入口
3:                  包含: 系统初始化、主循环、Timer0中断服务、引脚模拟/数字切换
4:                  扫描机制: 每250us(Timer0)扫描一个槽位, 三阶段扫描(ADC->充电处理->LED更新)
5:                  主循环: 空闲等待UART数据回环测试
6:                -------------------------------------------*/
7:                #include "config.h"
8:                #pragma warning disable 752
9:                #pragma warning disable 373
10:               
11:               /*========================================================================
12:                 全局变量定义
13:               ========================================================================*/
14:               volatile unsigned int power_ad;          /* 电源电压(mV), 每1s更新一次 */
15:               
16:               /* 系统计时变量 */
17:               unsigned int  g_timerTick = 0;           /* Timer0中断计数器(250us/tick), 4000tick=1秒 */
18:               unsigned int  g_systemTick = 0;          /* 系统秒计数器(每秒+1) */
19:               unsigned char g_scanIndex = 0;           /* 当前扫描槽位索引(0~11循环) */
20:               unsigned char g_scanPhase = 0;           /* 当前扫描阶段: 0=ADC采样, 1=充电处理, 2=扫描完成/收尾 */
21:               unsigned int  g_powerOnTimer = 0;        /* 上电自检计时器 */
22:               unsigned char g_powerOnPhase = 0;        /* 上电自检阶段: 0=全亮, 1=保持, 2=正常 */
23:               
24:               /*========================================================================
25:                 ROM只读配置表
26:               ========================================================================*/
27:               /* 12槽ADC通道映射表
28:                  每个槽位对应一个ADC通道号, 用于电压采样 */
29:               const unsigned char s_adcChannels[BATTERY_SLOTS] = {
30:               	ADC_CH_B1,  /* B1: AN0  */
31:               	ADC_CH_B2,  /* B2: AN1  */
32:               	ADC_CH_B3,  /* B3: AN11 */
33:               	ADC_CH_B4,  /* B4: AN10 */
34:               	ADC_CH_B5,  /* B5: AN3  */
35:               	ADC_CH_B6,  /* B6: AN2  */
36:               	ADC_CH_B7,  /* B7: AN23 */
37:               	ADC_CH_B8,  /* B8: AN25 */
38:               	ADC_CH_B9,  /* B9: AN8  */
39:               	ADC_CH_B10, /* B10: AN9 */
40:               	ADC_CH_B11, /* B11: AN24 */
41:               	ADC_CH_B12  /* B12: AN22 */
42:               };
43:               
44:               /* 12槽引脚配置表(ROM)
45:                  每个槽位包含: TRIS寄存器、PORT寄存器、引脚掩码、ANSEL寄存器、模拟选择掩码
46:                  用于分时复用: 同一引脚在ADC测量时切换为模拟, 在MOSFET控制时切换为数字 */
47:               const SlotPinConfig_t s_slotPins[BATTERY_SLOTS] = {
48:               	/* B1: RA0/AN0 */ { &TRISA, &PORTA, 0x01, &ANSEL0, 0x01 },
49:               	/* B2: RA1/AN1 */ { &TRISA, &PORTA, 0x02, &ANSEL0, 0x02 },
50:               	/* B3: RB3/AN11*/ { &TRISB, &PORTB, 0x08, &ANSEL1, 0x08 },
51:               	/* B4: RB2/AN10*/ { &TRISB, &PORTB, 0x04, &ANSEL1, 0x04 },
52:               	/* B5: RA3/AN3 */ { &TRISA, &PORTA, 0x08, &ANSEL0, 0x08 },
53:               	/* B6: RA2/AN2 */ { &TRISA, &PORTA, 0x04, &ANSEL0, 0x04 },
54:               	/* B7: RD1/AN23*/ { &TRISD, &PORTD, 0x02, &ANSEL3, 0x02 },
55:               	/* B8: RD3/AN25*/ { &TRISD, &PORTD, 0x08, &ANSEL3, 0x08 },
56:               	/* B9: RB0/AN8 */ { &TRISB, &PORTB, 0x01, &ANSEL1, 0x01 },
57:               	/* B10:RB1/AN9 */ { &TRISB, &PORTB, 0x02, &ANSEL1, 0x02 },
58:               	/* B11:RD2/AN24*/ { &TRISD, &PORTD, 0x04, &ANSEL3, 0x04 },
59:               	/* B12:RD0/AN22*/ { &TRISD, &PORTD, 0x01, &ANSEL3, 0x01 }
60:               };
