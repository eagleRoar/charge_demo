  005D    1283    CLRB	0x3,5
  005E    1303    CLRB	0x3,6
  005F    00BE    LD	0x3E,A
  0060    0854    LD	A,0x54
  0061    3E01    ADDIA	0x1
  0062    0084    LD	0x4,A
