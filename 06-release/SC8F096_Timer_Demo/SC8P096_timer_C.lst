  036D    0871    LD	A,0x71
  036E    1C03    SNZB	0x3,0
  036F    03F3    DECR	0x73
  0370    02F3    SUBR	0x73
  0371    1474    SETB	0x74,0
  0372    1003    CLRB	0x3,0
  0373    0CF1    RRCR	0x71
  0374    0CF0    RRCR	0x70
  0375    0BF6    SZDECR	0x76
