113:              /*========================================================================
114:                槽位电池数据(拆分为两个数组, 避免单Bank RAM溢出)
115:                每数组6个槽位*12字节=72字节, 可放入Bank0(96字节)和Bank1(80字节)
116:              ========================================================================*/
117:              BatterySlot_t g_slot0[6];       /* B1-B6 槽位数据 */
118:              BatterySlot_t g_slot1[6];       /* B7-B12 槽位数据 */
119:              
120:              /*========================================================================
121:                函数: ChargeProcess_Slot
122:                功能: 单槽充电状态机处理
123:                参数: idx - 槽位索引(0~11)
124:                说明: 每个Timer0中断(250us)调用一次, 处理一个槽位
125:                状态转换逻辑:
126:                  CHG_IDLE -> CHG_DETECT: 开始检测, 等待2s稳定
127:                  CHG_DETECT -> CHG_ACTIVATE: 电压<0.1V, 过放电池, 脉冲激活(最多60s)
128:                  CHG_DETECT -> CHG_PRECHARGE: 电压0.1V~0.5V, 小电流预充(最多5min)
129:                  CHG_DETECT -> CHG_CC_CHARGE: 电压>0.5V, 直接恒流充电
130:                  CHG_DETECT -> CHG_ERROR: 短路/镍氢/未知电池
131:                  CHG_ACTIVATE -> CHG_PRECHARGE: 电压>0.1V, 激活成功, 转为预充
132:                  CHG_ACTIVATE -> CHG_ERROR: 激活超时60s或电压>=过压
133:                  CHG_PRECHARGE -> CHG_CC_CHARGE: 电压>1.0V, 转为恒流充电
134:                  CHG_PRECHARGE -> CHG_ERROR: 预充超时5min或过压
135:                  CHG_CC_CHARGE -> CHG_CV_CHARGE: 电压>=满电(1.52V), 转为恒压充电
136:                  CHG_CC_CHARGE -> CHG_ERROR: 充电超时3h或过压
