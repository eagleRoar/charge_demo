85:               /*========================================================================
86:                 函数: PowerOnLedSequence
87:                 功能: 上电LED自检序列
88:                 说明: 系统上电后执行, 测试LED是否正常
89:                 流程:
90:                   Phase0: 全亮1s(LED IO1=1, LED IO2=1), 红灯和绿灯同时亮
91:                   Phase1: 保持1s(继续全亮)
92:                   Phase2: 关闭LED, 进入正常工作模式
93:                 目的: 检测LED是否正常, 同时给用户视觉反馈系统已启动
94:               ========================================================================*/
95:               void PowerOnLedSequence(void)
96:               {
97:               	g_powerOnTimer++;                    /* 自检计时器累加 */
  0B0B    1683    SETB	0x3,5
  0B0C    0ABA    INCR	0x3A
  0B0D    1903    SZB	0x3,2
  0B0E    0ABB    INCR	0x3B
98:               
99:               	if(g_powerOnPhase == 0)
  0B0F    1283    CLRB	0x3,5
  0B10    0853    LD	A,0x53
  0B11    1D03    SNZB	0x3,2
  0B12    2B25    JP	0x325
100:              	{
101:              		/* Phase 0: 全亮1秒 */
102:              		PIN_LED_IO1 = 1;                /* 红灯亮 */
  0B13    1703    SETB	0x3,6
  0B14    1686    SETB	0x6,5
103:              		PIN_LED_IO2 = 1;                /* 绿灯亮 */
  0B15    1606    SETB	0x6,4
104:              		if(g_powerOnTimer >= TICK_PER_SEC)
  0B16    3000    LDIA	0x0
  0B17    1683    SETB	0x3,5
  0B18    1303    CLRB	0x3,6
  0B19    023B    SUBA	0x3B
  0B1A    30DE    LDIA	0xDE
  0B1B    1903    SZB	0x3,2
  0B1C    023A    SUBA	0x3A
  0B1D    1C03    SNZB	0x3,0
  0B1E    0008    RET
105:              		{
106:              			g_powerOnTimer = 0;
  0B1F    01BA    CLR	0x3A
  0B20    01BB    CLR	0x3B
107:              			g_powerOnPhase = 1;         /* 进入Phase 1 */
  0B21    1283    CLRB	0x3,5
  0B22    01D3    CLR	0x53
  0B23    0AD3    INCR	0x53
  0B24    0008    RET
108:              		}
109:              	}
110:              	else if(g_powerOnPhase == 1)
  0B25    0B53    SZDECA	0x53
  0B26    0008    RET
111:              	{
112:              		/* Phase 1: 保持全亮1秒 */
113:              		if(g_powerOnTimer >= TICK_PER_SEC)
  0B27    3000    LDIA	0x0
  0B28    1683    SETB	0x3,5
  0B29    023B    SUBA	0x3B
  0B2A    30DE    LDIA	0xDE
  0B2B    1903    SZB	0x3,2
  0B2C    023A    SUBA	0x3A
  0B2D    1C03    SNZB	0x3,0
  0B2E    0008    RET
  0B2F    3002    LDIA	0x2
114:              		{
115:              			g_powerOnTimer = 0;
  0B30    01BA    CLR	0x3A
  0B31    01BB    CLR	0x3B
116:              			g_powerOnPhase = 2;         /* 进入Phase 2 */
  0B32    1283    CLRB	0x3,5
  0B33    00D3    LD	0x53,A
117:              			PIN_LED_IO1 = 0;            /* 关闭LED */
  0B34    1703    SETB	0x3,6
  0B35    1286    CLRB	0x6,5
118:              			PIN_LED_IO2 = 0;
  0B36    1206    CLRB	0x6,4
  0B37    0008    RET
119:              		}
120:              	}
121:              	/* Phase 2: 自检完成, 进入正常扫描 */
122:              }
