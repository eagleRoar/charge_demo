# 13 "E:\1.workspace\7.other\17.charge_demo\charge_demo\06-release\SC8F096_Timer_Demo\adc_drv.c"
volatile unsigned int adresult;
volatile unsigned char test_adc;

# 21
void AD_Init(void)
{
CC0CON = 0;
CC1CON = 0;
ADCON0 = 0X41;
ADCON1 = 0;
}

# 43
unsigned char ADC_Sample(unsigned char adch, unsigned char adldo)
{
volatile unsigned long adsum = 0;
volatile unsigned int admin = 0;
volatile unsigned int admax = 0;
volatile unsigned int ad_temp = 0;


if ((!LDO_EN) && (adldo & 0x04))
{
ADCON1 = adldo;
_delay((unsigned long)((100)*(16000000/4000000.0)));
}
else
ADCON1 = adldo;


if(adch & 0x10)
{
CHS4 = 1;
adch &= 0x0f;
}
else
CHS4 = 0;

unsigned char i = 0;

for (i = 0; i < 10; i++)
{

ADCON0 = (unsigned char)(0X41 | (adch << 2));
asm("nop");
asm("nop");
asm("nop");
asm("nop");
GODONE = 1;


unsigned char j = 0;
while (GODONE)
{
_delay((unsigned long)((2)*(16000000/4000000.0)));
if (0 == (--j))
return 0;
}


ad_temp = (unsigned int)((ADRESH << 4) + (ADRESL >> 4));


if (0 == admax)
{
admax = ad_temp;
admin = ad_temp;
}

else if (ad_temp > admax)
admax = ad_temp;

else if (ad_temp < admin)
admin = ad_temp;

adsum += ad_temp;
}


adsum -= admax;
if (adsum >= admin)
adsum -= admin;
else
adsum = 0;

adresult = adsum >> 3;


adsum = 0;
admin = 0;
admax = 0;
return 0xA5;
}

# 131
unsigned int ADC_ReadChannel(unsigned char ch)
{
test_adc = ADC_Sample(ch, 7);
if (0xA5 == test_adc)
return adresult;


ADCON0 = 0;
ADCON1 = 0;
_delay((unsigned long)((100)*(16000000/4000000.0)));
return 0;
}

# 14 "E:\1.workspace\7.other\17.charge_demo\charge_demo\06-release\SC8F096_Timer_Demo\charge_mgr.c"
unsigned int g_ntcAdc = 0;
unsigned char g_temperature = 25;
unsigned char g_tempProtect = 0;

# 29
unsigned char Read_Temperature(void)
{
unsigned int ntcVal = ADC_ReadChannel(21);
unsigned int ntcR;
unsigned char temp = 25;

g_ntcAdc = ntcVal;


if(ntcVal == 0 || ntcVal >= 4095)
return g_temperature;


ntcR = (unsigned int)((unsigned long)ntcVal * 10000UL / (4096UL - ntcVal));

# 47
if(ntcR > 32950) temp = 10;
else if(ntcR > 27330) temp = 15;
else if(ntcR > 22060) temp = 20;
else if(ntcR > 17950) temp = 25;
else if(ntcR > 14710) temp = 30;
else if(ntcR > 12120) temp = 35;
else if(ntcR > 10000) temp = 40;
else if(ntcR > 8330) temp = 45;
else if(ntcR > 6970) temp = 50;
else if(ntcR > 5860) temp = 55;
else if(ntcR > 4950) temp = 60;
else if(ntcR > 4200) temp = 65;
else if(ntcR > 3580) temp = 70;
else temp = 75;

g_temperature = temp;


if(temp >= 60)
g_tempProtect = 1;
else if(temp <= 50)
g_tempProtect = 0;

return temp;
}

# 87
unsigned char Detect_BatteryType(unsigned int voltage)
{

if(voltage <= 5)
return 4;


if(voltage <= 12)
return 1;


if(voltage >= 136 && voltage <= 161)
return 2;


if(voltage >= 62 && voltage <= 188)
return 1;


if(voltage > 188 && voltage < 198)
return 1;


return 0;
}

# 117
BatterySlot_t g_slot0[6];
BatterySlot_t g_slot1[6];

# 142
void ChargeProcess_Slot(unsigned char idx)
{
BatterySlot_t *p = (((idx) < 6) ? &g_slot0[(idx)] : &g_slot1[(idx)-6]);



if(idx == 2)
{
p->state = 0;
return;
}


unsigned int v = p->voltage;
unsigned int tick = 1;

switch(p->state)
{

case 0:
p->chargeTimer = 0;
p->stableCnt = 0;
p->state = 1;
break;


case 1:
p->chargeTimer += tick;
if(p->chargeTimer < (2 * 222))
break;


p->type = Detect_BatteryType(v);


if(p->type == 4 ||
p->type == 2 ||
p->type == 0)
{
p->state = 7;
break;
}


if(v <= 12)
{
p->state = 2;
p->chargeTimer = 0;
p->activatePulseCnt = 0;
}

else if(v < 62)
{
p->state = 3;
p->chargeTimer = 0;
}

else
{
p->state = 4;
p->chargeTimer = 0;
}
break;

# 208
case 2:
p->chargeTimer += tick;

if(p->chargeTimer > (60 * 222))
{
p->state = 7;
break;
}

if(v > 12)
{
p->state = 3;
p->chargeTimer = 0;
break;
}

if(v >= 198)
{
p->state = 7;
break;
}
break;


case 3:
p->chargeTimer += tick;

if(p->chargeTimer > (300 * 222))
{
p->state = 7;
break;
}

if(v >= 198)
{
p->state = 7;
break;
}

if(v >= 124)
{
p->state = 4;
p->chargeTimer = 0;
}
break;


case 4:
p->chargeTimer += tick;

if(p->chargeTimer > (10800 * 222))
{
p->state = 7;
break;
}

if(v >= 198)
{
p->state = 7;
break;
}

if(v >= 188)
{
p->state = 5;
p->chargeTimer = 0;
}
break;


case 5:
p->chargeTimer += tick;

if(v >= 198)
{
p->state = 7;
break;
}

if(p->chargeTimer > (600 * 222))
{
p->state = 6;
}
break;


case 6:

if(v < (188 - 10))
{
p->state = 4;
p->chargeTimer = 0;
}
break;


case 7:

if(v > 12 && v < 198 &&
p->type == 1)
{
p->state = 1;
p->chargeTimer = 0;
}
break;

default:
p->state = 0;
break;
}
}

# 332
void Charging_Control(void)
{
unsigned char i;
unsigned char chargeB1_6 = 0;
unsigned char chargeB7_12 = 0;


if(g_tempProtect)
{
do { RA0=1; RA1=1; RB3=1; RB2=1; RA3=1; RA2=1; RD1=1; RD3=1; RB0=1; RB1=1; RD2=1; RD0=1; } while(0);
RC3 = 0;
RC2 = 0;
g_pwmDuty = 0;
return;
}


for(i = 0; i < 12; i++)
{
unsigned char s = (((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->state;



if(i == 2)
{
do { switch(i) { case 0: RA0=1; break; case 1: RA1=1; break; case 2: RB3=1; break; case 3: RB2=1; break; case 4: RA3=1; break; case 5: RA2=1; break; case 6: RD1=1; break; case 7: RD3=1; break; case 8: RB0=1; break; case 9: RB1=1; break; case 10: RD2=1; break; case 11: RD0=1; break; } } while(0);
continue;
}



if(s == 2 || s == 3 ||
s == 4 || s == 5)
{
do { switch(i) { case 0: RA0=0; break; case 1: RA1=0; break; case 2: RB3=0; break; case 3: RB2=0; break; case 4: RA3=0; break; case 5: RA2=0; break; case 6: RD1=0; break; case 7: RD3=0; break; case 8: RB0=0; break; case 9: RB1=0; break; case 10: RD2=0; break; case 11: RD0=0; break; } } while(0);


if(i < 6)
chargeB1_6 = 1;
else
chargeB7_12 = 1;
}
else
{
do { switch(i) { case 0: RA0=1; break; case 1: RA1=1; break; case 2: RB3=1; break; case 3: RB2=1; break; case 4: RA3=1; break; case 5: RA2=1; break; case 6: RD1=1; break; case 7: RD3=1; break; case 8: RB0=1; break; case 9: RB1=1; break; case 10: RD2=1; break; case 11: RD0=1; break; } } while(0);
}
}


RC3 = chargeB1_6;
RC2 = chargeB7_12;


}

# 403
void CCCV_Control(void)
{
unsigned char i;
unsigned char hasCharging = 0;
unsigned int maxV = 0;
unsigned char cvCount = 0;


for(i = 0; i < 12; i++)
{
unsigned char s = (((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->state;



if(i == 2) continue;


if(s == 2 || s == 3 ||
s == 4 || s == 5)
{
hasCharging = 1;
if((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->voltage > maxV)
maxV = (((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->voltage;
if(s == 5)
cvCount++;
}
}


if(!hasCharging)
{
g_pwmDuty = 0;
g_cvIntegral = 0;
return;
}

# 442
if(cvCount == 0)
{
if(g_pwmDuty < 25)
{

g_pwmDuty += 3;
if(g_pwmDuty > 25)
g_pwmDuty = 25;
}
else if(g_pwmDuty > 25)
{

g_pwmDuty = 25;
}
else
{

g_pwmDuty = 25;
}
return;
}

# 469
{
int error = (int)(188) - (int)(maxV);


g_cvIntegral += error * 1;
if(g_cvIntegral > 200)
g_cvIntegral = 200;
else if(g_cvIntegral < -200)
g_cvIntegral = -200;


int adjust = (error * 4 + g_cvIntegral) / 8;
int duty = (int)g_pwmDuty + adjust;


if(duty > 32) duty = 32;
if(duty < 0) duty = 0;

g_pwmDuty = (unsigned char)duty;
}
}

# 30 "E:\1.workspace\7.other\17.charge_demo\charge_demo\06-release\SC8F096_Timer_Demo\led.c"
void Update_LED_Slot(unsigned char idx)
{
BatterySlot_t *p = (((idx) < 6) ? &g_slot0[(idx)] : &g_slot1[(idx)-6]);

switch(p->state)
{
case 0:
p->ledState = 0;
break;
case 1:
case 2:
case 3:
case 4:
case 5:
p->ledState = 1;
break;
case 6:
p->ledState = 2;
break;
case 7:
p->ledState = 3;
break;
default:
p->ledState = 0;
break;
}
}

# 66
void Led_BlinkProcess(void)
{
unsigned char i;
for(i = 0; i < 12; i++)
{

if((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->ledState == 3)
{
(((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->blinkTimer++;

if((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->blinkTimer >= (222 / 2))
{
(((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->blinkTimer = 0;
(((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->blinkPhase ^= 1;
}
}
}
}

# 95
void PowerOnLedSequence(void)
{
g_powerOnTimer++;

if(g_powerOnPhase == 0)
{

RC5 = 1;
RC4 = 1;
if(g_powerOnTimer >= 222)
{
g_powerOnTimer = 0;
g_powerOnPhase = 1;
}
}
else if(g_powerOnPhase == 1)
{

if(g_powerOnTimer >= 222)
{
g_powerOnTimer = 0;
g_powerOnPhase = 2;
RC5 = 0;
RC4 = 0;
}
}

}

# 22 "E:\1.workspace\7.other\17.charge_demo\charge_demo\06-release\SC8F096_Timer_Demo\uart_dbg.c"
void uart_send_char(unsigned char c)
{
while(TRMT1 == 0);
TXREG1 = c;
}

# 34
void uart_send_string(const unsigned char *str)
{
while(*str != '\0')
uart_send_char(*str++);
}

# 47
void uart_send_number(unsigned int num)
{
unsigned char buf[6];
unsigned char i = 0;
unsigned char j;


if(num == 0)
{
uart_send_char('0');
return;
}


while(num > 0)
{
buf[i++] = '0' + (num % 10);
num /= 10;
}


for(j = i; j > 0; j--)
uart_send_char(buf[j-1]);
}

# 86
void Print_Status(void)
{
unsigned char i;


uart_send_string("T:");
uart_send_number(g_temperature);
uart_send_string("C VDD:");
uart_send_number(power_ad);
uart_send_string("mV\r\n");


for(i = 0; i < 12; i++)
{
uart_send_string("B");
uart_send_number(i + 1);
uart_send_string(":V=");
uart_send_number((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->voltage);
uart_send_string(" S=");
uart_send_number((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->state);
uart_send_string(" T=");
uart_send_number((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->type);


if((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->state == 7)
uart_send_string(" ERR");
else if((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->state == 6)
uart_send_string(" FULL");
else if((((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->state == 4 ||
(((i) < 6) ? &g_slot0[(i)] : &g_slot1[(i)-6])->state == 5)
uart_send_string(" CHG");

uart_send_string("\r\n");
}
}

